{
  "protocol_version": 1,
  "sdk": "python",
  "root_name": "trusted-router-py",
  "capabilities": [
    "core",
    "retry_500",
    "telemetry_header",
    "transport_fault",
    "stream_integrity",
    "generated_idempotency",
    "redirect_isolation",
    "unsafe_retry_guard",
    "body_timeout",
    "caller_cancellation",
    "credential_free_oauth",
    "model_preservation",
    "retry_body_fault"
  ],
  "command": [
    "uv",
    "run",
    "--project",
    "{sdk_root}",
    "--frozen",
    "--no-dev",
    "python",
    "{repo}/drivers/python/driver.py"
  ]
}
