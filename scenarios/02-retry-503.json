{
  "protocol_version": 1,
  "name": "retry-503",
  "description": "A 503 is retried in place and preserves the idempotency key.",
  "requires": ["core"],
  "operation": {
    "method": "POST",
    "path": "/chat/completions",
    "body": {"model": "auto", "messages": []},
    "headers": {"x-conformance-case": "retry-503"},
    "idempotency_key": "tr-conformance-retry-503"
  },
  "client": {"max_retries": 1, "timeout_ms": 2000, "telemetry": false},
  "actions": [
    {
      "kind": "response",
      "status": 503,
      "json": {"error": {"message": "retry me", "type": "server_error"}}
    },
    {"kind": "response", "status": 200, "json": {"ok": true}}
  ],
  "expect": {
    "outcome": "success",
    "attempts": 2,
    "value_json_subset": {"ok": true},
    "same_headers": ["authorization", "idempotency-key"],
    "headers": {
      "idempotency-key": "tr-conformance-retry-503",
      "x-conformance-case": "retry-503",
      "x-tr-client": {"absent": true}
    }
  }
}
