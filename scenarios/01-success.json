{
  "protocol_version": 1,
  "name": "success",
  "description": "A generic inference POST sends the common credentials and decodes JSON.",
  "requires": ["core"],
  "operation": {
    "method": "POST",
    "path": "/chat/completions",
    "body": {
      "model": "auto",
      "messages": [{"role": "user", "content": "conformance"}]
    },
    "headers": {"x-conformance-case": "success"},
    "idempotency_key": "tr-conformance-success"
  },
  "client": {"max_retries": 0, "timeout_ms": 2000, "telemetry": false},
  "actions": [
    {"kind": "response", "status": 200, "json": {"ok": true}}
  ],
  "expect": {
    "outcome": "success",
    "attempts": 1,
    "value_json_subset": {"ok": true},
    "body_json_subset": {"model": "auto", "messages": [{"role": "user"}]},
    "headers": {
      "authorization": "Bearer tr-conformance-key",
      "content-type": {"matches": "(?i)application/json(?:;.*)?"},
      "idempotency-key": "tr-conformance-success",
      "user-agent": {"present": true},
      "x-conformance-case": "success",
      "x-tr-client": {"absent": true}
    }
  }
}
