{
  "protocol_version": 1,
  "name": "failover-disabled",
  "description": "Disabling regional failover permits a retry but never moves to another authority.",
  "requires": [
    "regional_failover"
  ],
  "operation": {
    "method": "POST",
    "path": "/chat/completions",
    "body": {
      "model": "test/model"
    },
    "idempotency_key": "tr-failover-disabled"
  },
  "client": {
    "endpoint": "default",
    "regional_failover": false,
    "max_retries": 1
  },
  "actions": [
    {
      "kind": "response",
      "status": 503,
      "json": {
        "error": {
          "message": "unavailable"
        }
      }
    },
    {
      "kind": "response",
      "status": 200,
      "json": {
        "ok": true
      }
    }
  ],
  "expect": {
    "outcome": "success",
    "attempts": 2,
    "attempt_hosts": [
      "api.trustedrouter.com",
      "api.trustedrouter.com"
    ],
    "same_headers": [
      "authorization",
      "idempotency-key"
    ],
    "value_json_subset": {
      "ok": true
    }
  }
}
